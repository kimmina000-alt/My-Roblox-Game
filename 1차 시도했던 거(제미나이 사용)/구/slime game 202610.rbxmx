	<Item class="Script" referent="RBXBF9D49E9274E43B89A582862769AB9BE">
		<Properties>
			<ProtectedString name="Source"><![CDATA[-- [[ 위치: ServerScriptService > Script ]]
-- [[ 역할: PVP 영역 내 체급(Size) 기반 흡수, 튕김 물리 계산 및 먹이(JellyPellet) 스폰 ]]

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

--------------------------------------------------------------------------------
-- ⚙️ [설정값 및 주요 변수]
--------------------------------------------------------------------------------
local CONFIG = {
	ABSORB_RATIO = 1.5,          -- 흡수 가능한 체급 차이 비율 (1.5배 이상)
	ABSORB_GAIN_RATE = 0.5,      -- 상대 체급 흡수 시 크기 증가 비율 (상대 크기의 50%)
	DEFAULT_SIZE = 1.0,          -- 플레이어 기본 크기 수치
	COLLISION_DEBOUNCE = 0.6,    -- 충돌 쿨타임 (초)

	PELLET_SIZE_GAIN = 0.1,      -- 먹이(JellyPellet) 획득 시 크기 증가량
	PELLET_RESPAWN_TIME = 3.0,   -- 먹이 재스폰 시간 (초)
	
	KNOCKBACK_POWER = 160,        -- 💡 [수정] 뒤로 튕겨 나가는 속도 힘 (세 걸음 거리)
	KNOCKBACK_UP_POWER = 60,     -- 💡 [수정] 튕길 때 살짝 위로 뜨는 힘 (마찰력 무시용)
	
	KNOCKBACK_FORCE = 30,  -- 💡 [수정] 강한 밀쳐내기 힘
	KNOCKBACK_TIME = 0.05,  -- 💡 [수정] 밀려나는 시간
	
	--KNOCKBACK_FORCE = 120,       -- 기본 튕김 밀쳐내기 힘 (Impulse)
	ABSORB_SOUND_ID = "rbxassetid://79712300185044", -- 흡수 시 '수풕-' 3D 오디오 ID
}

local collisionDebounceTable = {} -- [Player1_Player2] 형태의 쿨타임 관리 테이블

--------------------------------------------------------------------------------
-- 📐 [플레이어 슬라임 크기(Scale/Attributes) 동기화 함수]
--------------------------------------------------------------------------------
local function getSlimeSize(character)
	local sizeVal = character:GetAttribute("SlimeSize")
	if not sizeVal then
		character:SetAttribute("SlimeSize", CONFIG.DEFAULT_SIZE)
		return CONFIG.DEFAULT_SIZE
	end
	return sizeVal
end

local function setSlimeSize(character, newSize)
	newSize = math.max(newSize, CONFIG.DEFAULT_SIZE)
	character:SetAttribute("SlimeSize", newSize)

	-- 💡 캐릭터의 Scale 속성을 조절하여 실제 체급 크기를 확대/축소
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		
		-- 방법 1: BodyScale 값 조절 (R15 아바타 표준)
		local depth = humanoid:FindFirstChild("BodyDepthScale")
		local height = humanoid:FindFirstChild("BodyHeightScale")
		local width = humanoid:FindFirstChild("BodyWidthScale")
		local head = humanoid:FindFirstChild("HeadScale")

		if depth then depth.Value = newSize end
		if height then height.Value = newSize end
		if width then width.Value = newSize end
		if head then head.Value = newSize end

		-- 방법 2: ScaleTo() 호환
		pcall(function()
			humanoid:ScaleTo(newSize)
		end)
	end
end

--------------------------------------------------------------------------------
-- 🔊 [흡수 3D 오디오 재생 함수]
--------------------------------------------------------------------------------
local function playAbsorbSound(position)
	local soundPart = Instance.new("Part")
	soundPart.Anchored = true
	soundPart.CanCollide = false
	soundPart.Transparency = 1
	soundPart.Position = position
	soundPart.Parent = Workspace

	local sound = Instance.new("Sound")
	sound.SoundId = CONFIG.ABSORB_SOUND_ID
	sound.Volume = 1.2
	sound.RollOffMaxDistance = 50
	sound.RollOffMinDistance = 5
	sound.Parent = soundPart

	sound:Play()
	sound.Ended:Connect(function()
		soundPart:Destroy()
	end)
end

--------------------------------------------------------------------------------
-- 💥 [플레이어 간 충돌 처리 로직 (흡수 vs 튕김)]
--------------------------------------------------------------------------------
-- 💡 물리 인스턴스로 밀쳐내기 처리 함수 (네트워크 소유권 문제 해결)
local function applyKnockback(targetRoot, directionVector)
	local attachment = Instance.new("Attachment")
	attachment.Parent = targetRoot

	local linearVelocity = Instance.new("LinearVelocity")
	linearVelocity.Attachment0 = attachment
	linearVelocity.MaxForce = 100000 -- 캐릭터 무게를 이기는 강한 힘
	linearVelocity.VectorVelocity = directionVector * CONFIG.KNOCKBACK_FORCE + Vector3.new(0, 30, 0) -- 위로 살짝 띄움
	linearVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
	linearVelocity.Parent = targetRoot

	-- 짧은 순간 밀어내고 제거
	task.delay(CONFIG.KNOCKBACK_TIME, function()
		linearVelocity:Destroy()
		attachment:Destroy()
	end)
end

local function onCharacterTouched(otherPart, characterA)
	local characterB = otherPart.Parent
	if not characterB or characterA == characterB then return end

	local playerA = Players:GetPlayerFromCharacter(characterA)
	local playerB = Players:GetPlayerFromCharacter(characterB)

	if not playerA or not playerB then return end

	local rootA = characterA:FindFirstChild("HumanoidRootPart")
	local rootB = characterB:FindFirstChild("HumanoidRootPart")
	local humA = characterA:FindFirstChildOfClass("Humanoid")
	local humB = characterB:FindFirstChildOfClass("Humanoid")

	if not rootA or not rootB or not humA or not humB then return end
	if humA.Health <= 0 or humB.Health <= 0 then return end

	local p1Id, p2Id = playerA.UserId, playerB.UserId
	local debounceKey = (p1Id < p2Id) and (p1Id .. "_" .. p2Id) or (p2Id .. "_" .. p1Id)

	if collisionDebounceTable[debounceKey] then return end
	collisionDebounceTable[debounceKey] = true
	task.delay(CONFIG.COLLISION_DEBOUNCE, function()
		collisionDebounceTable[debounceKey] = nil
	end)

	local sizeA = getSlimeSize(characterA)
	local sizeB = getSlimeSize(characterB)

	-- 1. [A가 B를 흡수]
	if sizeA >= sizeB * CONFIG.ABSORB_RATIO then
		humB.Health = 0
		setSlimeSize(characterA, sizeA + (sizeB * CONFIG.ABSORB_GAIN_RATE))
		playAbsorbSound(rootA.Position)

		-- 2. [B가 A를 흡수]
	elseif sizeB >= sizeA * CONFIG.ABSORB_RATIO then
		humA.Health = 0
		setSlimeSize(characterB, sizeB + (sizeA * CONFIG.ABSORB_GAIN_RATE))
		playAbsorbSound(rootB.Position)

		-- 3. 💡 [동등 체급 튕김: LinearVelocity 물리를 통한 확실한 밀쳐내기]
	else
		local pushDir = (rootB.Position - rootA.Position)
		local flatDir = Vector3.new(pushDir.X, 0, pushDir.Z).Unit

		if flatDir.Magnitude == 0 or flatDir.X ~= flatDir.X then
			flatDir = Vector3.new(1, 0, 0)
		end

		applyKnockback(rootA, -flatDir)
		applyKnockback(rootB, flatDir)
	end
end
--------------------------------------------------------------------------------
-- 🟢 [먹이(JellyPellet) 상호작용 및 자동 스폰 로직]
--------------------------------------------------------------------------------
local function setupJellyPellet(pellet)
	local debounce = false
	pellet.Touched:Connect(function(hit)
		if debounce then return end
		local character = hit.Parent
		local player = Players:GetPlayerFromCharacter(character)

		if player and character then
			local hum = character:FindFirstChildOfClass("Humanoid")
			if hum and hum.Health > 0 then
				debounce = true

				-- 크기 증가
				local currentSize = getSlimeSize(character)
				setSlimeSize(character, currentSize + CONFIG.PELLET_SIZE_GAIN)

				-- 먹이 투명화 및 리스폰 대기
				pellet.Transparency = 1
				pellet.CanCollide = false

				task.wait(CONFIG.PELLET_RESPAWN_TIME)
				pellet.Transparency = 0
				pellet.CanCollide = true
				debounce = false
			end
		end
	end)
end

--------------------------------------------------------------------------------
-- 🎮 [플레이어 접속 & 캐릭터 스폰 초기화]
--------------------------------------------------------------------------------
Players.PlayerAdded:Connect(function(player)
	player.CharacterAdded:Connect(function(character)
		task.wait(0.2) -- 캐릭터 로드 대기
		setSlimeSize(character, CONFIG.DEFAULT_SIZE)

		local rootPart = character:WaitForChild("HumanoidRootPart")
		rootPart.Touched:Connect(function(hit)
			onCharacterTouched(hit, character)
		end)
	end)
end)

-- 맵 상의 기존 및 신규 JellyPellet 파트 바인딩 (Workspace 내 'JellyPellets' 폴더 참조)
task.spawn(function()
	local pelletFolder = Workspace:WaitForChild("JellyPellets", 5)
	if pelletFolder then
		for _, pellet in ipairs(pelletFolder:GetChildren()) do
			if pellet:IsA("BasePart") then
				setupJellyPellet(pellet)
			end
		end
		pelletFolder.ChildAdded:Connect(function(pellet)
			if pellet:IsA("BasePart") then
				setupJellyPellet(pellet)
			end
		end)
	end
end)

print("[SlimePvpService] PVP 체급 물리 및 먹이 시스템 활성화 완료!")]]></ProtectedString>
			<bool name="Disabled">false</bool>
			<Content name="LinkedSource"><null></null></Content>
			<token name="RunContext">0</token>
			<string name="ScriptGuid">{B66FEDB3-CE23-49DF-9670-E02D0503720C}</string>
			<BinaryString name="AttributesSerialize"></BinaryString>
			<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
			<bool name="DefinesCapabilities">false</bool>
			<string name="Name">SlimePvpService</string>
			<int64 name="SourceAssetId">-1</int64>
			<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
		</Properties>
	</Item>
	<Item class="Script" referent="RBXC0A83F84954946C4995833C7DFD4681A">
		<Properties>
			<ProtectedString name="Source"><![CDATA[-- [[ 위치: ServerScriptService > WorkerSlimeService ]]
-- [[ 역할: 하우징 내 노동자 슬라임 오토 노동, Pathfinding, AFK 골드 생산 및 ASMR 제어 (찌그러짐 제거 버전)]]
-- [[  Floating Text 골드 연출, 속도/레벨 업그레이드 처리 ]]

local PathfindingService = game:GetService("PathfindingService")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local PlayerDataService = require(script.Parent:WaitForChild("PlayerDataService"))

-- RemoteEvent 생성 (상점 업그레이드용)
local upgradeWorkerEvent = ReplicatedStorage:FindFirstChild("UpgradeWorkerEvent")
if not upgradeWorkerEvent then
	upgradeWorkerEvent = Instance.new("RemoteEvent")
	upgradeWorkerEvent.Name = "UpgradeWorkerEvent"
	upgradeWorkerEvent.Parent = ReplicatedStorage
end

--------------------------------------------------------------------------------
-- ?? [기본 설정값]
--------------------------------------------------------------------------------
local CONFIG = {
	BASE_GOLD_PER_WORK = 10,
	WORK_INTERVAL = 0.1, -- 발판에 도달 후 작업 및 대기 시간 (초)

	WORK_SOUND_ID = "rbxassetid://127105730240202", -- 발판 밟을 때 재생되는 ASMR 소리
	SOUND_MAX_DISTANCE = 50,
	SOUND_MIN_DISTANCE = 5,

	RUN_ANIM_R6 = "rbxassetid://180436334",
	RUN_ANIM_R15 = "rbxassetid://913376220",
}
--------------------------------------------------------------------------------
-- ?? [WorkerSlime 등 뒤 3D Floating Text 연출]
--------------------------------------------------------------------------------
local function showFloatingGoldText(workerPart, goldAmount)
	if not workerPart then return end

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "GoldFloatingText"
	billboard.Size = UDim2.new(0, 120, 0, 40)
	billboard.StudsOffset = Vector3.new(0, 2.5, 0)
	billboard.AlwaysOnTop = true
	billboard.Adornee = workerPart
	billboard.Parent = workerPart

	local textLabel = Instance.new("TextLabel")
	textLabel.Size = UDim2.new(1, 0, 1, 0)
	textLabel.BackgroundTransparency = 1
	textLabel.Text = "+" .. goldAmount .. " Gold!"
	textLabel.TextColor3 = Color3.fromRGB(255, 220, 50)
	textLabel.TextStrokeColor3 = Color3.fromRGB(80, 50, 0)
	textLabel.TextStrokeTransparency = 0
	textLabel.TextSize = 20
	textLabel.Font = Enum.Font.FredokaOne
	textLabel.Parent = billboard

	-- 위로 떠오르면서 투명해지는 애니메이션
	local tweenInfo = TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local tweenOffset = TweenService:Create(billboard, tweenInfo, {StudsOffset = Vector3.new(0, 4.5, 0)})
	local tweenText = TweenService:Create(textLabel, tweenInfo, {TextTransparency = 1, TextStrokeTransparency = 1})

	tweenOffset:Play()
	tweenText:Play()

	task.delay(1.2, function()
		billboard:Destroy()
	end)
end
--------------------------------------------------------------------------------
-- ?? 노동자 슬라임 뛰기 애니메이션 등록
--------------------------------------------------------------------------------
local function setupWorkerAnimation(worker)
	local humanoid = worker:FindFirstChildOfClass("Humanoid")
	if not humanoid then return end

	local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)
	local animId = (humanoid.RigType == Enum.HumanoidRigType.R6) and CONFIG.RUN_ANIM_R6 or CONFIG.RUN_ANIM_R15

	local runAnimation = Instance.new("Animation")
	runAnimation.AnimationId = animId

	--if not animator then
	--	animator = Instance.new("Animator")
	--	animator.Parent = humanoid
	--end

	--local runAnimation = Instance.new("Animation")
	--runAnimation.AnimationId = animId

	local runTrack
	pcall(function()
		runTrack = animator:LoadAnimation(runAnimation)
		runTrack.Priority = Enum.AnimationPriority.Movement
	end)

	humanoid.Running:Connect(function(speed)
		if runTrack then
			if speed > 0.5 then
				if not runTrack.IsPlaying then
					runTrack:Play(0.10, 1, math.clamp(speed / 16, 0.8, 3.0))
				else
					-- 속도가 바뀌면 애니메이션 재생 속도도 즉시 변경
					runTrack:AdjustSpeed(math.clamp(speed / 16, 0.8, 3.0))
				end
			else
				if runTrack.IsPlaying then
					runTrack:Stop(0.15)
				end
			end
		end
	end)
end

--------------------------------------------------------------------------------
-- ??? 노동자 슬라임 셋업 및 Attribute 설정
--------------------------------------------------------------------------------
local function setupWorkerAttributes(worker)
	if not worker:GetAttribute("WorkerLevel") then
		worker:SetAttribute("WorkerLevel", 1)
	end
	if not worker:GetAttribute("WalkSpeed") then
		worker:SetAttribute("WalkSpeed", 12)
	end
	if not worker:GetAttribute("GoldMultiplier") then
		worker:SetAttribute("GoldMultiplier", 1.0)
	end

	local humanoid = worker:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.WalkSpeed = worker:GetAttribute("WalkSpeed")

		worker:GetAttributeChangedSignal("WalkSpeed"):Connect(function()
			humanoid.WalkSpeed = worker:GetAttribute("WalkSpeed")
		end)
	end

	setupWorkerAnimation(worker)
end

--------------------------------------------------------------------------------
-- ?? [3D ASMR 공간 사운드 재생]
--------------------------------------------------------------------------------
local function playWorkSound(parentPart)
	local sound = parentPart:FindFirstChild("SlimeWorkASMR")or Instance.new("Sound", parentPart)
	--if not sound then
	--sound = Instance.new("Sound")
	sound.Name = "SlimeWorkASMR"
	sound.SoundId = CONFIG.WORK_SOUND_ID
	sound.Volume = 0.8
	--sound.RollOffMode = Enum.RollOffMode.InverseTapered
	sound.RollOffMinDistance = CONFIG.SOUND_MIN_DISTANCE
	sound.RollOffMaxDistance = CONFIG.SOUND_MAX_DISTANCE
	--sound.Parent = parentPart
	--end

	sound.TimePosition = 0
	sound:Play()
end

--------------------------------------------------------------------------------
-- ?? Pathfinding 이동 및 노동 루프
--------------------------------------------------------------------------------
local function startWorkerLoop(housingFolder)
	local worker = housingFolder:FindFirstChild("WorkerSlime")
	local padsFolder = housingFolder:FindFirstChild("SlimePads")
	--local ownerUserId = housingFolder:GetAttribute("OwnerUserId")

	if not worker or not padsFolder then return end

	local humanoid = worker:FindFirstChildOfClass("Humanoid")
	local rootPart = worker:FindFirstChild("HumanoidRootPart")
	if not humanoid or not rootPart then return end

	setupWorkerAttributes(worker)

	task.spawn(function()
		local pads = padsFolder:GetChildren()
		local currentPadIndex = 1

		while worker and worker.Parent and humanoid.Health > 0 do
			pads = padsFolder:GetChildren()
			if #pads == 0 then task.wait(2) continue end

			local targetPad = pads[currentPadIndex]
			if targetPad and targetPad:IsA("BasePart") then

				-- 1. Pathfinding 길찾기 이동
				local path = PathfindingService:CreatePath({
					AgentRadius = 2,
					AgentHeight = 3
				})
				pcall(function() path:ComputeAsync(rootPart.Position, targetPad.Position) end)


				if path.Status == Enum.PathStatus.Success then
					for _, waypoint in ipairs(path:GetWaypoints()) do
						humanoid:MoveTo(waypoint.Position)
						if not humanoid.MoveToFinished:Wait() then break end
					end
				else
					humanoid:MoveTo(targetPad.Position)
					humanoid.MoveToFinished:Wait()
				end

				-- 2. ?? 패드 도달 시: 찌그러짐 없이 소리만 재생 후 골드 지급
				playWorkSound(targetPad)

				local level = worker:GetAttribute("WorkerLevel") or 1
				local multiplier = worker:GetAttribute("GoldMultiplier") or 1.0
				local earnedGold = math.floor(CONFIG.BASE_GOLD_PER_WORK * level * multiplier)

				local ownerUserId = housingFolder:GetAttribute("OwnerUserId")
				local owner = ownerUserId and Players:GetPlayerByUserId(ownerUserId)
				if owner then
					local data = PlayerDataService.GetData(owner)
					local incomeMultiplier = data and data.WorkerIncomeMultiplier or 1
					local finalGold = math.floor(earnedGold * incomeMultiplier)
					PlayerDataService.AddGold(owner, finalGold)
					showFloatingGoldText(rootPart, finalGold)
				end
				-- 3. 패드에서 1초간 작업 대기 후 다음 패드로 이동
				task.wait(CONFIG.WORK_INTERVAL)
				currentPadIndex = (currentPadIndex % #pads) + 1
			else
				task.wait(1)
			end
		end
	end)
end
--------------------------------------------------------------------------------
-- ?? [상점 업그레이드 이벤트 처리]
--------------------------------------------------------------------------------
upgradeWorkerEvent.OnServerEvent:Connect(function(player, upgradeType)
	local data = PlayerDataService.GetData(player)
	if not data then return end

	local housingPlots = workspace:FindFirstChild("HousingPlots")
	if not housingPlots then return end
	local playerHousing
	for _, plot in ipairs(housingPlots:GetChildren()) do
		if plot:GetAttribute("OwnerUserId") == player.UserId then
			playerHousing = plot
			break
		end
	end
	if not playerHousing then
		local plots = housingPlots:GetChildren()
		if #plots == 1 and plots[1]:GetAttribute("OwnerUserId") == nil then playerHousing = plots[1] end
	end
	local worker = playerHousing and playerHousing:FindFirstChild("WorkerSlime")
	if not worker then return end

	if upgradeType == "Speed" then
		local currentSpeed = worker:GetAttribute("WalkSpeed") or 12
		if PlayerDataService.SpendGold(player, math.floor(currentSpeed * 15)) then
			worker:SetAttribute("WalkSpeed", currentSpeed + 4)
		end
	elseif upgradeType == "Level" then
		local currentLevel = worker:GetAttribute("WorkerLevel") or 1
		if PlayerDataService.SpendGold(player, currentLevel * 100) then
			worker:SetAttribute("WorkerLevel", currentLevel + 1)
		end
	end
end)

local housingPlotsFolder = workspace:WaitForChild("HousingPlots", 10) or workspace

local function onHousingAdded(housingFolder)
	if housingFolder:IsA("Folder") or housingFolder:IsA("Model") then
		startWorkerLoop(housingFolder)
	end
end

for _, plot in ipairs(housingPlotsFolder:GetChildren()) do
	onHousingAdded(plot)
end

housingPlotsFolder.ChildAdded:Connect(onHousingAdded)

print("[WorkerSlimeService] WorkerSlime 찌그러짐 제거 및 패드 사운드 전용 설정 적용 완료!")]]></ProtectedString>
