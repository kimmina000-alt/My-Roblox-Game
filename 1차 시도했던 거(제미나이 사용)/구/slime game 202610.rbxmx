					<ProtectedString name="Source"><![CDATA[-- [[ 위치: StarterGui > ToppingCleaningGui > CleaningClientController ]]
-- [[ 역할: 단일 아이템 인벤토리 UI, Q(버리기)/E(줍기/진열하기), 알림 및 세척대 통합 ]]

local Players = game:GetService("Players")
